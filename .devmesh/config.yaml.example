# Copy this file to .devmesh/config.yaml and fill in your API information.
# config.yaml is ignored by Git; real API keys will not be uploaded.

providers:
  # Most third-party platforms, OneAPI/NewAPI, vLLM, and Ollama use this protocol.
  - name: my-openai-compatible-api
    protocol: openai-compat
    # The application appends /chat/completions automatically.
    # If the full endpoint is https://example.com/v1/chat/completions, set only /v1 here.
    base_url: https://example.com/v1
    api_key: "replace-with-your-api-key"
    model: replace-with-your-model-id
    thinking: false
    context_window: 128000
    max_output_tokens: 8192

  # OpenRouter uses the OpenAI-compatible Chat Completions API.
  # Omit base_url to use https://openrouter.ai/api/v1 automatically.
  # Set OPENROUTER_API_KEY or provide api_key directly.
  # Optional headers improve OpenRouter attribution and rankings.
  # - name: openrouter
  #   protocol: openrouter
  #   model: openai/gpt-4o-mini
  #   api_key: "replace-with-your-openrouter-api-key"
  #   headers:
  #     HTTP-Referer: https://your-site.example
  #     X-Title: DevMesh

  # Anthropic Messages API example:
  # - name: anthropic-official
  #   protocol: anthropic
  #   base_url: https://api.anthropic.com
  #   api_key: "replace-with-your-api-key"
  #   model: claude-sonnet-4-20250514
  #   thinking: true

  # OpenAI Responses API example (not regular Chat Completions):
  # - name: openai-official
  #   protocol: openai
  #   base_url: https://api.openai.com/v1
  #   api_key: "replace-with-your-api-key"
  #   model: gpt-4o
  #   thinking: false

permission_mode: default

# MCP is optional. Uncomment when needed and make sure the required runtime is installed locally.
# mcp_servers:
#   - name: context7
#     command: npx
#     args: ["-y", "@upstash/context7-mcp"]

# Streamable HTTP MCP example:
# mcp_servers:
#   - name: my-http-mcp
#     url: https://example.com/mcp
#     transport: http
#     headers:
#       Authorization: "Bearer ${MY_TOKEN}"
